# =============================================================================
# .env.example — copy to .env and fill in your values
# =============================================================================

PORT=5000
NODE_ENV=development

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# JWT — MUST be a long, cryptographically-random string in production (min 64 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the example value below in any real environment.
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string_before_deploying

JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
