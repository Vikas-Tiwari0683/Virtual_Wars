{
  "name": "carbontrace-backend",
  "version": "1.0.0",
  "description": "CarbonTrace REST API — Express + PostgreSQL (Neon)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "test": "jest --testPathPattern=src/test"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/test/**/*.test.js"
    ],
    "testEnvironmentOptions": {
      "env": { "NODE_ENV": "test" }
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  }
}
